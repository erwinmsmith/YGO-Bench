# Provider selection used by `ygo-bench eval`.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash

# Set only the key for the provider you use.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible local servers can be selected with:
# LLM_PROVIDER=vllm
# LLM_MODEL=your/model
# LLM_BASE_URL=http://127.0.0.1:8000/v1

# Explicit OpenAI-compatible profiles for mixed-provider experiments.
# Keep these separate so one duel can use different endpoints per agent.
# Alibaba Cloud Bailian (for example, Kimi/Qwen)
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-flash

# External OpenAI-compatible service (this project uses Code Soul/Qwen)
EXTERNAL_API_KEY=
EXTERNAL_BASE_URL=https://api.code-soul.com/v1
EXTERNAL_MODEL=qwen3.5:9b-128k
